# WebDock Dev settings. Copy this file to:
#   Windows: %LOCALAPPDATA%\WebDockDev\.env
#   Linux/macOS: <data dir>/.env   (see LDP_DATA_DIR)
# and restart WebDock Dev. Real environment variables take precedence. Only LDP_* keys are read.

# MariaDB root password. Set it BEFORE the first start (an existing database keeps its old password).
# Default when unset: root (the database is only reachable from this PC).
LDP_DB_ROOT_PASSWORD=change-me

# Dashboard port (default 9000)
#LDP_PORT=9000

# Folder that holds your projects (default <data dir>\sites)
#LDP_SITES_DIR=D:\Websites
